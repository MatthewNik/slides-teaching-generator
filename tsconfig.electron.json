{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": ["electron/**/*.ts", "src/lib/types.ts", "src/lib/schemas.ts", "src/lib/mathNormalize.ts"],
  "exclude": ["node_modules"]
}
